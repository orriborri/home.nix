prefix_rule(
    pattern = [["aws", "/home/orre/.nix-profile/bin/aws", "/nix/var/nix/profiles/default/bin/aws", "/run/current-system/sw/bin/aws", "/usr/bin/aws", "/usr/local/bin/aws", "/nix/store/b305hhnmsdzxbq7fbcjrdps6kwyw3cm2-awscli2-2.35.11/bin/aws"]],
    decision = "prompt",
    justification = "Show the exact AWS command and obtain explicit user approval, including read-only calls.",
    match = ["aws sts get-caller-identity", "aws ec2 describe-instances", "/home/orre/.nix-profile/bin/aws s3 ls"],
    not_match = ["git status"],
)
