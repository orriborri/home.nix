#!/usr/bin/env bash
# Pre-push gate: run `nix flake check` on each commit being pushed (the
# committed tree, not the working tree).
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency: git push --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # Deleting a remote branch: nothing to check.
  [[ "$local_sha" == "$zero" ]] && continue
  echo "pre-push: nix flake check on ${local_sha:0:12}"
  nix flake check "git+file://$PWD?rev=$local_sha"
done
