#!/usr/bin/env bash
set -euo pipefail

# Standalone SSM port-forward to the KiroCrew portal.
# Reads instance ID, profile, and region from the launcher state file.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_FILE="${SCRIPT_DIR}/.kirocrew-ec2.json"

if [ ! -f "$STATE_FILE" ]; then
  echo "ERROR: No state file at ${STATE_FILE}" >&2
  echo "Run launch-ec2 first to create an instance." >&2
  exit 1
fi

INSTANCE_ID=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d['instance_id'])" "$STATE_FILE")
PROFILE=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d['profile'])" "$STATE_FILE")
REGION=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d['region'])" "$STATE_FILE")

if [ -z "$INSTANCE_ID" ]; then
  echo "ERROR: No instance ID in state file" >&2
  exit 1
fi

REMOTE_PORT=5476
LOCAL_PORT=7780

# Kill any existing process bound to the local port. lsof/ss/fuser are not
# guaranteed on PATH here, so map the port to a PID via /proc directly.
python3 - "$LOCAL_PORT" <<'PYEOF'
import os, signal, sys, time

port = int(sys.argv[1])

def listening_pids(port):
    inodes = set()
    for pf in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(pf) as fh:
                next(fh, None)
                for line in fh:
                    f = line.split()
                    if len(f) < 10 or f[3] != "0A":
                        continue
                    if int(f[1].rsplit(":", 1)[1], 16) == port:
                        inodes.add(f[9])
        except OSError:
            pass
    if not inodes:
        return []
    pids = set()
    for e in os.scandir("/proc"):
        if not e.name.isdigit():
            continue
        try:
            for fd in os.listdir(f"{e.path}/fd"):
                try:
                    link = os.readlink(f"{e.path}/fd/{fd}")
                except OSError:
                    continue
                if link.startswith("socket:[") and link[8:-1] in inodes:
                    pids.add(int(e.name))
                    break
        except OSError:
            continue
    return sorted(pids)

pids = listening_pids(port)
for pid in pids:
    print(f"» Killing old process on port {port} (PID {pid})")
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
if pids:
    time.sleep(0.5)
    for pid in listening_pids(port):
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
PYEOF

echo "» KiroCrew portal: http://127.0.0.1:${LOCAL_PORT}"
echo "  Instance: ${INSTANCE_ID} (${PROFILE}, ${REGION})"
echo "  Keep this running; press Ctrl+C to close the tunnel."

exec aws ssm start-session \
  --profile "$PROFILE" \
  --region "$REGION" \
  --target "$INSTANCE_ID" \
  --document-name AWS-StartPortForwardingSession \
  --parameters "{\"portNumber\":[\"${REMOTE_PORT}\"],\"localPortNumber\":[\"${LOCAL_PORT}\"]}"
