#!/usr/bin/env python3
"""slack-api — minimal Slack Web API CLI for pasta's Slack fetcher.

Usage:
  slack-api <method> [k=v ...]  # Call API method

Examples:
  slack-api conversations.list types=im limit=10
  slack-api users.info user=U123

Token: SLACK_BOT_TOKEN from the environment (pasta-fetchers.env), else
access_token from ~/.config/slack-api/token.json. The token is static: this
packaged copy has no OAuth or refresh flow (the Slack client secret it needed
was retired).
"""

import json, sys, os, urllib.request, urllib.parse

TOKEN_FILE = os.path.expanduser("~/.config/slack-api/token.json")


def get_token():
    bot_token = os.environ.get("SLACK_BOT_TOKEN", "").strip()
    if bot_token:
        return bot_token
    try:
        with open(TOKEN_FILE) as f:
            return json.load(f)["access_token"]
    except (OSError, KeyError, ValueError):
        print(f"No Slack token: set SLACK_BOT_TOKEN or write {TOKEN_FILE}", file=sys.stderr)
        sys.exit(1)


def call_api(method, params):
    token = get_token()
    qs = urllib.parse.urlencode(params) if params else ""
    url = f"https://slack.com/api/{method}?{qs}" if qs else f"https://slack.com/api/{method}"
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    resp = urllib.request.urlopen(req).read()
    sys.stdout.buffer.write(resp)
    sys.stdout.buffer.write(b"\n")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    method = sys.argv[1]
    params = {}
    for arg in sys.argv[2:]:
        if "=" in arg:
            k, v = arg.split("=", 1)
            params[k] = v
    call_api(method, params)
