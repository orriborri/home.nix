#!/usr/bin/env python3
"""slack-api — Slack Web API CLI with OAuth token management.

Usage:
  slack-api auth          # One-time OAuth flow (opens browser)
  slack-api <method> [k=v ...]  # Call API method
  
Examples:
  slack-api auth
  slack-api search.messages query=to:me count=10
  slack-api conversations.list types=im limit=10
  slack-api users.info user=U123
"""

import json, sys, os, time, urllib.request, urllib.parse, http.server, webbrowser, threading

TOKEN_FILE = os.path.expanduser("~/.config/slack-api/token.json")
CLIENT_ID = "24625456983.11254265706929"
CLIENT_SECRET = "7aad5b72cb4c3ae19b523322676078fa"
SCOPES = "channels:history,groups:history,im:history,mpim:history,channels:read,groups:read,users:read,search:read,chat:write,im:read"
REDIRECT_PORT = 19847
REDIRECT_URI = f"http://localhost:{REDIRECT_PORT}/callback"


def load_token():
    if not os.path.exists(TOKEN_FILE):
        return None
    with open(TOKEN_FILE) as f:
        return json.load(f)


def save_token(data):
    os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
    with open(TOKEN_FILE, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(TOKEN_FILE, 0o600)


def refresh_token(token_data):
    """Attempt to refresh using rotation if available."""
    refresh = token_data.get("refresh_token")
    if not refresh:
        return None
    params = urllib.parse.urlencode({
        "client_id": CLIENT_ID,
        "client_secret": CLIENT_SECRET,
        "grant_type": "refresh_token",
        "refresh_token": refresh,
    }).encode()
    req = urllib.request.Request("https://slack.com/api/oauth.v2.access", data=params)
    resp = json.loads(urllib.request.urlopen(req).read())
    if resp.get("ok"):
        new_data = {
            "access_token": resp["authed_user"]["access_token"],
            "refresh_token": resp.get("refresh_token", refresh),
            "token_type": "user",
            "obtained_at": int(time.time()),
        }
        save_token(new_data)
        return new_data
    return None


def get_token():
    data = load_token()
    if not data:
        print("No token found. Run: slack-api auth", file=sys.stderr)
        sys.exit(1)
    # Try refresh if we have a refresh_token and token is old (>11h)
    if data.get("refresh_token") and time.time() - data.get("obtained_at", 0) > 39600:
        refreshed = refresh_token(data)
        if refreshed:
            return refreshed["access_token"]
    return data["access_token"]


def do_auth():
    """Run OAuth flow with local redirect server."""
    auth_url = (
        f"https://slack.com/oauth/v2/authorize?"
        f"client_id={CLIENT_ID}&user_scope={SCOPES}&redirect_uri={REDIRECT_URI}"
    )
    code_holder = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            code_holder["code"] = qs.get("code", [None])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(b"<h2>Slack auth complete. You can close this tab.</h2>")

        def log_message(self, *a):
            pass

    server = http.server.HTTPServer(("127.0.0.1", REDIRECT_PORT), Handler)
    thread = threading.Thread(target=server.handle_request, daemon=True)
    thread.start()

    print(f"Opening browser for Slack OAuth...")
    webbrowser.open(auth_url)
    thread.join(timeout=120)
    server.server_close()

    code = code_holder.get("code")
    if not code:
        print("Error: No auth code received.", file=sys.stderr)
        sys.exit(1)

    # Exchange code for token
    params = urllib.parse.urlencode({
        "client_id": CLIENT_ID,
        "client_secret": CLIENT_SECRET,
        "code": code,
        "redirect_uri": REDIRECT_URI,
    }).encode()
    req = urllib.request.Request("https://slack.com/api/oauth.v2.access", data=params)
    resp = json.loads(urllib.request.urlopen(req).read())

    if not resp.get("ok"):
        print(f"Error: {resp.get('error')}", file=sys.stderr)
        sys.exit(1)

    user = resp.get("authed_user", {})
    token_data = {
        "access_token": user["access_token"],
        "refresh_token": user.get("refresh_token"),
        "token_type": "user",
        "scope": user.get("scope", SCOPES),
        "obtained_at": int(time.time()),
    }
    save_token(token_data)
    print(f"Authenticated as user in team: {resp.get('team', {}).get('name', '?')}")
    print(f"Token saved to {TOKEN_FILE}")


def call_api(method, params):
    token = get_token()
    qs = urllib.parse.urlencode(params) if params else ""
    url = f"https://slack.com/api/{method}?{qs}" if qs else f"https://slack.com/api/{method}"
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    resp = urllib.request.urlopen(req).read()
    sys.stdout.buffer.write(resp)
    sys.stdout.buffer.write(b"\n")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    if sys.argv[1] == "auth":
        do_auth()
    else:
        method = sys.argv[1]
        params = {}
        for arg in sys.argv[2:]:
            if "=" in arg:
                k, v = arg.split("=", 1)
                params[k] = v
        call_api(method, params)
